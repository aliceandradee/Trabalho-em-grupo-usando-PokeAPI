<Window x:Class="PokeAPI.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokeAPI - Sistema de Relatórios" Height="730" Width="550"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#475569" Padding="15" Grid.Row="0" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <TextBlock Text="RELATÓRIO ESTRATÉGICO POKÉMON" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <ListBox x:Name="ListaPokemons" Grid.Row="1" Margin="15" Background="Transparent" BorderThickness="0" SelectionMode="Multiple">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="4" Margin="0,5" Padding="15" BorderThickness="1" BorderBrush="#E2E8F0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" Source="{Binding SpriteUrl}" Width="60" Height="60" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding NomeExibicao}" FontSize="17" FontWeight="Bold" Foreground="#1E293B"/>
                                    <TextBlock Text="{Binding CompetitiveRole}" Foreground="#10B981" FontSize="12" Margin="0,1,0,3" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Total de Poder: " FontSize="11" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding BaseStatTotal}" FontWeight="Bold" FontSize="11" Foreground="#334155"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="4" Padding="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <StackPanel>
                                        <TextBlock Text="ID" FontSize="9" Foreground="#94A3B8" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Id}" FontSize="11" FontWeight="Bold" Foreground="#475569" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border x:Name="PainelGrafico" Margin="0,15,0,0" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,10,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="ANÁLISE DE ATRIBUTOS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Pontos de Vida" Grid.Column="0" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Value="{Binding HP}" Maximum="150" Height="10" Background="#F8FAFC" Foreground="#3B82F6" BorderThickness="0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding HP}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ataque" Grid.Column="0" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Value="{Binding Attack}" Maximum="150" Height="10" Background="#F8FAFC" Foreground="#EF4444" BorderThickness="0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Attack}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Defesa" Grid.Column="0" FontSize="11" Foreground="#475569" VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1" Value="{Binding Defense}" Maximum="150" Height="10" Background="#F8FAFC" Foreground="#10B981" BorderThickness="0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Defense}" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="PainelGrafico" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="15,0,15,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnCarregar" Content="ATUALIZAR DADOS" Click="BtnCarregar_Click" Grid.Column="0" Margin="0,0,7,0" Padding="0,12" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
            <Button x:Name="BtnExportar" Content="EXPORTAR SELEÇÃO" Click="BtnExportar_Click" Grid.Column="1" Margin="7,0,0,0" Padding="0,12" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        </Grid>
    </Grid>
</Window>