<Window x:Class="PokeAPI.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PokeAPI - Sistema de Relatórios" Height="700" Width="550"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#2D3E50" Padding="20" Grid.Row="0">
            <TextBlock Text="GERAÇÃO DE RELATÓRIO" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <ListBox x:Name="ListaPokemons" Grid.Row="1" Margin="15" Background="Transparent" BorderThickness="0" SelectionMode="Multiple">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,5"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E2E8F0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="8" Padding="15" BorderThickness="1" BorderBrush="#CBD5E1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" Source="{Binding SpriteUrl}" Width="80" Height="80"/>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding NomeExibicao}" FontSize="18" FontWeight="Bold"/>

                                <TextBlock Text="{Binding CompetitiveRole}" Foreground="Green"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="HP: "/>
                                    <TextBlock Text="{Binding HP}" FontWeight="Bold"/>
                                    <TextBlock Text=" ATK: " Margin="5,0,0,0"/>
                                    <TextBlock Text="{Binding Attack}" FontWeight="Bold"/>
                                    <TextBlock Text=" DEF: " Margin="5,0,0,0"/>
                                    <TextBlock Text="{Binding Defense}" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="PODER TOTAL" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding BaseStatTotal}" FontSize="20" FontWeight="Bold" Foreground="Red" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="15">
            <Button x:Name="BtnCarregar" Content="ATUALIZAR DADOS" Click="BtnCarregar_Click" Padding="20,10" Background="#3B82F6" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button x:Name="BtnExportar" Content="SALVAR RELATÓRIO" Click="BtnExportar_Click" Padding="20,10" Background="#10B981" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>